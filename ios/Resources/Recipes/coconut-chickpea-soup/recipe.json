        {
          "ingredient": "garlic"
        },
        {
          "ingredient": "onion"
        },
        {
          "ingredient": "ginger"
        },
        {
          "ingredient": "salt"
        },
        {
          "ingredient": "pepper"
        }
      ],
      "outputs": [
        {
          "id": "soft-aromatics",
          "name": "Softened aromatics"
        }
      ],
      "instruction": "Heat the oil over medium heat. Cook the garlic, onion and ginger with salt and pepper for 3–5 minutes, stirring occasionally, until the onion is translucent and browning at the edges.",
      "clarification": "Medium heat",
      "duration": {
        "min": 3,
        "max": 5,
        "unit": "min"
      }
    },
    {
      "id": "fry-chickpeas",
      "action": "Fry chickpeas",
      "inputs": [
        {
          "output": "soft-aromatics"
