      "name": "Salt",
      "quantity": "To taste"
    },
    {
      "id": "pepper",
      "name": "Black pepper",
      "quantity": "To taste"
    },
    {
      "id": "turmeric",
      "name": "Turmeric",
      "quantity": "1½ tsp + extra",
