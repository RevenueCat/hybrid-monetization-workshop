      "clarification": "About 1 cup"
    },
    {
      "id": "crush",
      "action": "Crush lightly",
      "inputs": [
        {
          "output": "remaining-chickpeas"
        }
      ],
      "outputs": [
        {
          "id": "crushed-chickpeas",
          "name": "Lightly crushed chickpeas"
        }
      ],
      "instruction": "Lightly crush some of the chickpeas left in the pot to help thicken the soup."
    },
    {
      "id": "add-liquid",
      "action": "Add liquids",
      "inputs": [
        {
          "output": "crushed-chickpeas"
        },
        {
          "ingredient": "coconut-milk"
        },
        {
          "ingredient": "stock"
        },
        {
          "ingredient": "salt"
        },
        {
          "ingredient": "pepper"
        }
      ],
      "outputs": [
        {
          "id": "soup-base",
          "name": "Soup base"
        }
      ],
      "instruction": "Stir in the coconut milk and stock; season with salt and pepper."
    },
    {
      "id": "simmer",
      "action": "Simmer",
      "inputs": [
        {
          "output": "soup-base"
        }
      ],
      "outputs": [
        {
          "id": "simmered-soup",
          "name": "Simmered soup"
        }
      ],
      "instruction": "Bring to a simmer and scrape up the browned bits. Simmer, stirring occasionally, for 30–35 minutes until thickened. Taste a chickpea as well as the liquid; simmer longer if needed for the texture you want.",
