        {
          "ingredient": "turmeric",
          "allocation": "1½ tsp"
        },
        {
          "ingredient": "cayenne",
          "allocation": "1 tsp"
        },
        {
          "ingredient": "chickpeas"
        },
        {
          "ingredient": "salt"
        },
        {
          "ingredient": "pepper"
        }
      ],
      "outputs": [
        {
          "id": "fried-chickpeas",
          "name": "Fried chickpeas"
        }
      ],
