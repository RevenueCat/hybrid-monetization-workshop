      "duration": {
        "min": 30,
        "max": 35,
        "unit": "min"
      }
    },
    {
      "id": "toast-bread",
      "action": "Toast",
      "inputs": [
        {
          "ingredient": "bread",
          "optional": true
        }
      ],
      "outputs": [
        {
          "id": "toasted-bread",
          "name": "Toasted flatbread"
        }
      ],
      "instruction": "If serving bread, toast it to accompany the soup.",
      "clarification": "Optional accompaniment"
    },
    {
      "id": "serve",
      "action": "Serve",
      "inputs": [
        {
          "output": "simmered-soup"
        },
        {
          "output": "reserved-chickpeas"
        },
        {
          "ingredient": "mint",
          "optional": true
        },
        {
          "ingredient": "yogurt",
          "optional": true
        },
        {
          "output": "toasted-bread",
          "optional": true
        },
        {
          "ingredient": "olive-oil",
          "allocation": "Extra drizzle"
        },
        {
          "ingredient": "cayenne",
          "allocation": "Extra sprinkle"
        },
        {
          "ingredient": "turmeric",
          "allocation": "Extra for yogurt",
          "optional": true
        }
      ],
      "outputs": [
        {
          "id": "served-soup",
          "name": "Served soup"
        }
      ],
      "instruction": "Divide into bowls. Add the reserved chickpeas, a drizzle of oil and a sprinkle of cayenne. Serve with mint, yogurt and toasted bread if desired; optionally dust the yogurt with turmeric."
    }
